// SHG Collagen Image Analysis
//
// Purpose:
// Fiji/ImageJ macro used to quantify collagen fiber area fraction,
// inter-fiber spacing, and fiber coherency from second harmonic
// generation (SHG) images using thresholding, distance-map analysis,
// and the OrientationJ plugin.
//
// Software:
// Fiji/ImageJ
//
// Required plugin:
// OrientationJ
//
// Associated study:
// Bone-on-chip image analysis
//
// Author:
// Verónica Sosa-Castellano
//
// Version: 1.0
//
// Notes:
// This macro corresponds to the SHG collagen image-analysis workflow
// described in the associated manuscript. Image selection and z-plane
// selection are performed manually, whereas thresholding, preprocessing,
// and OrientationJ analysis are applied using fixed parameters.
//
// The workflow outputs measurements for collagen fiber area fraction,
// inter-fiber spacing, and coherency, which must be recorded/exported
// by the user.


// Select the image to be analyzed
waitForUser("Select the SHG image to be analyzed, then click OK");


// Enhance contrast
run("Enhance Contrast...", "saturated=0 equalize process_all");


// Split stack into individual images
run("Stack to Images");


// Select the z-plane to be analyzed
waitForUser("Select the z-plane to be analyzed, then click OK");


// Rename selected image
rename("Base");


// Duplicate image for each analysis
run("Duplicate...", "title=Fibers");
run("Duplicate...", "title=Pores");
run("Duplicate...", "title=Orientation");


// 1. COLLAGEN FIBER AREA FRACTION

selectWindow("Fibers");
setAutoThreshold("Moments dark");
setOption("BlackBackground", true);
run("Convert to Mask");
run("Set Measurements...", "area_fraction decimal=3");
run("Measure");

waitForUser("Record the AREA FRACTION measurement, then click OK");


// Save binary image
dir = getDirectory("Choose output folder");
name = getTitle();
saveAs("Tiff", dir + name + "_binary.tif");
run("Close");


// 2. INTER-FIBER SPACING

selectWindow("Pores");
setAutoThreshold("Moments dark");
run("Convert to Mask");
run("Distance Map");
run("Histogram");

waitForUser("Record the mean and standard deviation from the distance-map histogram, then click OK");
run("Close");


// 3. COLLAGEN FIBER ORIENTATION AND COHERENCY

selectWindow("Orientation");
run("Gaussian Blur...", "sigma=1");
run("Enhance Contrast...", "saturated=0.3");

run("OrientationJ Distribution",
    "tensor=7 gradient=4 orientation=on coherency=on histogram=on table=on min-coherency=10 min-energy=5");

selectWindow("OJ-Coherency-1");
run("Set Measurements...", "mean standard min max decimal=3");
run("Measure");

waitForUser("Record the mean and standard deviation of the coherency measurements, then click OK");

run("Close All");

